{
  "schema": "process-geometry/finite-le-corpus/v0",
  "context": {"parameter": "N", "direction": "+infinity", "assumptions": {"N": "positive"}, "branch_policy": "real-positive-log"},
  "observer": {"kind": "exact-limit", "residual_order": 1},
  "cases": [
    {
      "id": "p1-mixed-exp-nesting",
      "expression": {"op": "exp", "argument": {"op": "add", "terms": [
        {"op": "exp", "argument": {"op": "add", "terms": [
          {"op": "symbol", "name": "N"},
          {"op": "mul", "factors": [{"op": "const", "value": "2"}, {"op": "exp", "argument": {"op": "mul", "factors": [{"op": "const", "value": "-1"}, {"op": "symbol", "name": "N"}]}}]}
        ]}},
        {"op": "mul", "factors": [{"op": "const", "value": "-1"}, {"op": "exp", "argument": {"op": "symbol", "name": "N"}}]}
      ]}},
      "expected": {"status": "evaluated", "q": 1, "limit": "exp(2)"}
    },
    {
      "id": "p2-third-order-log-cancellation",
      "expression": {"op": "mul", "factors": [
        {"op": "exp", "argument": {"op": "mul", "factors": [{"op": "const", "value": "3"}, {"op": "symbol", "name": "N"}]}},
        {"op": "add", "terms": [
          {"op": "log", "argument": {"op": "add", "terms": [{"op": "const", "value": "1"}, {"op": "exp", "argument": {"op": "mul", "factors": [{"op": "const", "value": "-1"}, {"op": "symbol", "name": "N"}]}}]}},
          {"op": "mul", "factors": [{"op": "const", "value": "-1"}, {"op": "exp", "argument": {"op": "mul", "factors": [{"op": "const", "value": "-1"}, {"op": "symbol", "name": "N"}]}}]},
          {"op": "mul", "factors": [{"op": "const", "value": "1/2"}, {"op": "exp", "argument": {"op": "mul", "factors": [{"op": "const", "value": "-2"}, {"op": "symbol", "name": "N"}]}}]}
        ]}
      ]},
      "expected": {"status": "evaluated", "q": 1, "limit": "1/3", "minimum_cancellation_jump": 2}
    },
    {
      "id": "p3-rational-rate-q6",
      "expression": {"op": "mul", "factors": [
        {"op": "exp", "argument": {"op": "mul", "factors": [{"op": "const", "value": "1/3"}, {"op": "symbol", "name": "N"}]}},
        {"op": "add", "terms": [
          {"op": "exp", "argument": {"op": "add", "terms": [
            {"op": "exp", "argument": {"op": "mul", "factors": [{"op": "const", "value": "-1/2"}, {"op": "symbol", "name": "N"}]}},
            {"op": "exp", "argument": {"op": "mul", "factors": [{"op": "const", "value": "-1/3"}, {"op": "symbol", "name": "N"}]}}
          ]}},
          {"op": "const", "value": "-1"}
        ]}
      ]},
      "expected": {"status": "evaluated", "q": 6, "limit": "1"}
    },
    {
      "id": "n1-log-domain-missing",
      "expression": {"op": "log", "argument": {"op": "symbol", "name": "x"}},
      "expected": {"status": "unsupported", "failure": "log-domain-not-certified-positive"}
    },
    {
      "id": "n2-irrational-rate",
      "expression": {"op": "exp", "argument": {"op": "mul", "factors": [{"op": "const", "value": "sqrt(2)"}, {"op": "symbol", "name": "N"}]}},
      "expected": {"status": "unsupported", "failure": "invalid-rational-constant"}
    },
    {
      "id": "n3-nested-unbounded-scale",
      "expression": {"op": "exp", "argument": {"op": "exp", "argument": {"op": "symbol", "name": "N"}}},
      "expected": {"status": "unsupported", "failure": "nested-unbounded-exponential-scale"}
    },
    {
      "id": "n4-symbolic-height",
      "expression": {"op": "symbolic-iterate", "function": "exp", "seed": {"op": "symbol", "name": "x"}, "height_symbol": "h"},
      "expected": {"status": "unsupported", "failure": "symbolic-height-outside-finite-le-fragment"}
    }
  ]
}
